# The hosted default is an explicit simulation. Set live only with all signer values present.
DEMO_CHAIN_MODE=simulation
PUBLIC_LIVE_RUNS_ENABLED=false
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
EVALVAULT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Server-side only. Never expose these through NEXT_PUBLIC_* variables.
OPERATOR_PRIVATE_KEY=0xREPLACE_WITH_OPERATOR_KEY
EVALUATOR_PRIVATE_KEY=0xREPLACE_WITH_EVALUATOR_KEY
BUYER_PRIVATE_KEY=0xREPLACE_WITH_BUYER_KEY
OPERATOR_TOKEN=replace-with-long-random-token
EVALUATION_SEED=replace-with-private-suite-seed

# Covers evidence price only; gas remains separately bounded by the fixed Base Sepolia chain and method allowlist.
LIVE_RUN_BUDGET_WEI=2000000000000
EVALVAULT_DEPLOYMENT_BLOCK=0
